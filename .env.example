# Voyage / Travel OS
# Copy to .env.local. The product runs fully without any of these keys.

NEXT_PUBLIC_APP_URL=http://localhost:3002

# Optional: AMap JS API. When empty, MockMapProvider is used.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# Optional: OpenAI-compatible LLM. When empty, MockTravelAgent is used.
# Server-side only. Must be public http/https. Localhost and private hosts are rejected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: Supabase. When empty, in-memory TripRepository is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
