# Voyage / Travel OS
# Copy to .env.local. The product runs fully without any of these keys.

NEXT_PUBLIC_APP_URL=http://localhost:3002

# Optional: AMap. JS SDK uses the public key; REST uses the server key.
# When empty, MockMap + demo POIs are used.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
AMAP_SERVER_KEY=

# Optional: Fliggy/Taobao TOP hotel distribution APIs. Server-side only.
# These APIs require a Fliggy partner/app approval and must never be exposed to the browser.
FLIGGY_APP_KEY=
FLIGGY_APP_SECRET=
FLIGGY_SESSION=
FLIGGY_DISTRIBUTOR=
FLIGGY_EXTERNAL_AGENT_NAME=voyage-web
FLIGGY_API_URL=https://eco.taobao.com/router/rest

# Optional: official Meituan travel Skill. The CLI uses its own fixed official endpoint.
# Set MEITUAN_HT_TOKEN in the shell/Skill runtime; never use NEXT_PUBLIC_* for it.
MEITUAN_HT_TOKEN=
MEITUAN_RAW_JSON=1

# Explicit offline fixture mode. Never enable this in a real deployment.
VOYAGE_DEMO_MODE=false

# Optional: OpenAI-compatible LLM. When empty, MockTravelAgent is used.
# Server-side only. Must be public http/https. Localhost and private hosts are rejected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: Supabase. When empty, in-memory TripRepository is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
